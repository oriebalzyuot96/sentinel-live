{
  "name": "sentinel-live",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4310 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:pages": "ng build --configuration pages",
    "build:root": "ng build --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/dist/index.mjs",
    "server": "npm run server:build && node server/dist/index.mjs",
    "server:sim": "npm run server:build && node server/dist/index.mjs --sim-operator",
    "e2e": "npm run build && npm run server:build && node e2e/smoke.mjs",
    "heap": "node e2e/heap.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "description": "Real-time video analytics dashboard demo (Angular + RxJS + WebSockets) with simulated detections.",
  "license": "UNLICENSED",
  "author": "Orieb Alzyuot"
}
